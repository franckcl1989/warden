{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warden.local/contracts/hardware-certification.schema.json",
  "title": "Warden 0.1.0 hardware certification matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "release_candidate", "generated_at", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "product_version": {"const": "0.1.0"},
    "release_candidate": {"type": "string", "minLength": 1, "maxLength": 128},
    "generated_at": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "captured_at", "sanitized"],
      "properties": {
        "kind": {
          "enum": ["device_response", "device_ui", "device_cli", "device_log", "task_record", "audit_record", "protocol_document", "fixture", "test_report"]
        },
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/sha256"},
        "captured_at": {"type": "string", "format": "date-time"},
        "sanitized": {"const": true}
      }
    },
    "automated_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "status", "report_path", "sha256"],
      "properties": {
        "test_id": {"type": "string", "pattern": "^T-(SRV|NAS|CORE|ACCESS)-(MON|ACT)-[0-9]{2}$"},
        "status": {"const": "passed"},
        "report_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id", "target_id", "requirement_id", "capability_key", "capability_kind",
        "adapter_key", "actual_device_model", "firmware_version", "license_snapshot",
        "protocol_evidence", "status", "automated_tests", "evidence", "result_summary"
      ],
      "properties": {
        "record_id": {"type": "string", "pattern": "^HC-[A-Za-z0-9._:-]+$", "maxLength": 240},
        "target_id": {
          "enum": [
            "server.dell_idrac",
            "server.inspur_ibmc",
            "server.xfusion_ibmc",
            "server.lenovo_xcc",
            "server.huawei_ibmc",
            "nas.synology_ds224plus",
            "nas.synology_ds225plus",
            "core.huawei_s5732_h48xum2cc",
            "core.huawei_s5731s_s48p4x_a",
            "access.huawei_s5735_l48p4s_a1"
          ]
        },
        "requirement_id": {"type": "string", "pattern": "^(SRV|NAS|CORE|ACCESS)-(MON|ACT)-[0-9]{2}$"},
        "capability_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$", "maxLength": 160},
        "capability_kind": {"enum": ["metric", "event", "operation"]},
        "operation_profile_id": {"type": "string", "pattern": "^(SRV|NAS|CORE|ACCESS)-ACT-[0-9]{2}:[a-z][a-z0-9_.]*$"},
        "adapter_key": {"type": "string", "minLength": 1, "maxLength": 160},
        "actual_device_model": {"type": "string", "minLength": 1, "maxLength": 200},
        "firmware_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "license_snapshot": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "uniqueItems": true},
        "protocol_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 1},
        "status": {"enum": ["not_started", "automated_passed", "hardware_passed", "unsupported_with_evidence", "failed"]},
        "automated_tests": {"type": "array", "items": {"$ref": "#/$defs/automated_test"}, "uniqueItems": true},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "hardware_report_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "executed_at": {"type": "string", "format": "date-time"},
        "executed_by": {"type": "string", "minLength": 1, "maxLength": 200},
        "maintenance_window_ref": {"type": "string", "minLength": 1, "maxLength": 300},
        "user_acceptance_ref": {"type": "string", "minLength": 1, "maxLength": 300},
        "result_summary": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "allOf": [
        {
          "if": {"properties": {"capability_kind": {"const": "operation"}}, "required": ["capability_kind"]},
          "then": {"required": ["operation_profile_id", "maintenance_window_ref"]},
          "else": {"not": {"required": ["operation_profile_id"]}}
        },
        {
          "if": {"properties": {"status": {"const": "hardware_passed"}}, "required": ["status"]},
          "then": {
            "required": ["hardware_report_path", "executed_at", "executed_by"],
            "properties": {
              "automated_tests": {"minItems": 1},
              "evidence": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "unsupported_with_evidence"}}, "required": ["status"]},
          "then": {
            "required": ["hardware_report_path", "executed_at", "executed_by", "user_acceptance_ref"],
            "properties": {"evidence": {"minItems": 1}}
          }
        }
      ]
    }
  }
}
