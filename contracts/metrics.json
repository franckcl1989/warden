{
  "schema_version": 1,
  "product_version": "0.1.0",
  "rules": {
    "missing_value": "缺失值不得写成 0、正常或上一值；写入 observation_error，并由能力支持状态与数据新鲜度共同解释",
    "unit_normalization": "适配器必须在入库前转换为本目录单位，原始单位只可放入脱敏证据",
    "healthy_inference": "没有异常不等于健康；只有设备明确健康或完整规则证据才能产生健康状态",
    "counter_reset": "累计计数器回绕或设备重启后的首个派生点标记 partial，不生成负速率"
  },
  "enum_sets": {
    "health_state": ["unknown", "healthy", "warning", "critical"],
    "indicator_state": ["unknown", "off", "normal", "warning", "critical", "identify"],
    "condition_state": ["unknown", "normal", "detected"],
    "component_status": ["unknown", "ok", "warning", "critical", "absent"],
    "smart_status": ["unknown", "passed", "warning", "failed", "running"],
    "raid_status": ["unknown", "optimal", "degraded", "rebuilding", "failed"],
    "presence_state": ["unknown", "present", "absent"],
    "interface_admin_state": ["unknown", "up", "down", "testing"],
    "interface_oper_state": ["unknown", "up", "down", "dormant", "testing", "not_present", "lower_layer_down"],
    "poe_port_state": ["unknown", "on", "off", "denied", "fault"],
    "stp_port_state": ["unknown", "disabled", "discarding", "learning", "forwarding", "broken"],
    "ups_state": ["unknown", "normal", "on_battery", "low_battery", "communication_lost", "fault"],
    "alarm_state": ["unknown", "normal", "warning", "critical"]
  },
  "definitions": [
