# =====================================================================
# Warden 0.1.0 部署配置模板（仅非秘密配置；DEPLOYMENT §5）
# 复制为 deployment/compose/.env 后按注释填写。
# 秘密一律走 /srv/warden/secrets/ 只读文件挂载（Docker secret 风格），禁止写进本文件。
# 变量名与 backend/app/config.py（WARDEN_ 前缀）一一对应；部署级变量（WARDEN_DATA_DIR、
# WARDEN_TLS_*、WARDEN_IMAGE_*）仅供 Compose/Nginx 使用。
# =====================================================================

# ---- 运行身份 ----
WARDEN_APP_ENV=production
WARDEN_PUBLIC_URL=https://warden.example.internal
WARDEN_DISPLAY_TIMEZONE=Asia/Shanghai

# ---- 数据库（二选一；必须是应用账号 warden_app 的 DSN，见 postgres-init/01-accounts.sh）----
# 推荐：用 WARDEN_POSTGRES_DSN_FILE 指向只读挂载的 DSN Secret 文件（密码不进本文件）。
# warden_app 是最小权限应用账号：无建库/超级用户权限，且对 audit_logs 无 UPDATE/DELETE
# （SECURITY §11/§12，迁移 0004 显式 REVOKE）。迁移使用独立 warden_migrate 账号，
# 其 DSN Secret（postgres_dsn_migrate）由 compose migrate 服务覆盖，应用进程不接触。
# 密码只允许 [A-Za-z0-9._-]（避免 URL 编码/SQL 引号问题，见 deployment/README.md）。
WARDEN_POSTGRES_DSN=
WARDEN_POSTGRES_DSN_FILE=/run/secrets/postgres_dsn

# ---- Secret 文件路径（容器内 /run/secrets 只读挂载；宿主机文件在 /srv/warden/secrets/）----
WARDEN_CREDENTIAL_MASTER_KEY_FILE=/run/secrets/credential_master_key
WARDEN_FILE_MASTER_KEY_FILE=/run/secrets/file_master_key
WARDEN_SESSION_SECRET_FILE=/run/secrets/session_secret
WARDEN_CSRF_SECRET_FILE=/run/secrets/csrf_secret

# ---- 设备网络策略（必填；为空时设备探测全部拒绝，DEPLOYMENT §3/§5）----
WARDEN_ALLOWED_DEVICE_CIDRS=

# ---- 采集 / 任务 / 保留（默认值与 config.py 一致；保留期可降低，未测容量不得提高，ADR-027）----
WARDEN_REACHABILITY_INTERVAL_SECONDS=30
WARDEN_METRICS_INTERVAL_SECONDS=60
WARDEN_LOGS_INTERVAL_SECONDS=120
WARDEN_DISCOVERY_INTERVAL_SECONDS=21600
WARDEN_COLLECTION_WORKERS=4
WARDEN_OPERATION_WORKERS=2
WARDEN_TASK_LEASE_SECONDS=300
WARDEN_RAW_RETENTION_DAYS=7
WARDEN_ROLLUP_5M_RETENTION_DAYS=30
WARDEN_ROLLUP_1H_RETENTION_DAYS=180
WARDEN_EVENT_RETENTION_DAYS=180
WARDEN_RESOLVED_ALERT_RETENTION_DAYS=180
WARDEN_OPERATION_RETENTION_DAYS=365
WARDEN_AUDIT_RETENTION_DAYS=365
WARDEN_SUPPORT_BUNDLE_RETENTION_DAYS=30
WARDEN_CONFIG_BACKUP_KEEP_PER_DEVICE=10
WARDEN_CONFIG_BACKUP_MIN_DAYS=90

# ---- 文件配额（部署可降低，无容量证据不得提高，ADR-027）----
WARDEN_MAX_SUPPORT_BUNDLE_BYTES=5368709120
WARDEN_MAX_FIRMWARE_BYTES=10737418240
WARDEN_MAX_VIRTUAL_MEDIA_BYTES=53687091200

# ---- 事件接收（容器内非特权端口；宿主机固定映射 UDP 162、UDP/TCP 514，DEPLOYMENT §3）----
WARDEN_SYSLOG_UDP_PORT=1514
WARDEN_SYSLOG_TCP_PORT=1514
WARDEN_SNMP_TRAP_PORT=1162
WARDEN_INGEST_BIND_HOST=0.0.0.0

# ---- 设备拉取固件/虚拟介质的平台基础 URL（启用设备主动拉取时必填）----
WARDEN_DEVICE_ACCESS_BASE_URL=

# ---- 引导（首个管理员；users 表非空时拒绝。密码只从 stdin/Secret 文件读取）----
WARDEN_BOOTSTRAP_ADMIN_USERNAME=

# ---- Nginx TLS（容器内路径；宿主机文件 /srv/warden/tls/fullchain.pem、privkey.pem）----
WARDEN_TLS_CERT_FILE=/etc/nginx/tls/fullchain.pem
WARDEN_TLS_KEY_FILE=/etc/nginx/tls/privkey.pem

# ---- 持久化目录根（宿主机，DEPLOYMENT §4）----
WARDEN_DATA_DIR=/srv/warden

# ---- 镜像引用（无公网交付必须替换为 digest 固定引用，DEPLOYMENT §10）----
# 示例：WARDEN_IMAGE_APP=warden-app:0.1.0@sha256:<64位hex>
WARDEN_IMAGE_APP=warden-app:0.1.0
WARDEN_IMAGE_NGINX=warden-nginx:0.1.0
WARDEN_IMAGE_POSTGRES=postgres:18
