#!/usr/bin/env bash
# Warden 宿主机部署命令（docs/DEPLOYMENT.md §6/§8；ADR-026：维护模式只有宿主机入口，无 Web API）
# 运行位置：部署主机（Linux），不在容器内。只做部署级操作，不新增业务接口。
set -euo pipefail

WARDEN_DEPLOYMENT_DIR="${WARDEN_DEPLOYMENT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
COMPOSE_FILE="$WARDEN_DEPLOYMENT_DIR/compose/compose.yaml"
ENV_FILE="$WARDEN_DEPLOYMENT_DIR/compose/.env"

log_info() { printf '\033[1;32m[通过]\033[0m %s\n' "$*"; }
log_warn() { printf '\033[1;33m[警告]\033[0m %s\n' "$*"; }
log_fail() { printf '\033[1;31m[失败]\033[0m %s\n' "$*"; }

compose() { docker compose -f "$COMPOSE_FILE" "$@"; }

usage() {
    cat <<'EOF'
用法：warden <命令> [参数]

  preflight                       部署前预检（DEPLOYMENT §6 步骤 1/4）
  maintenance on|off              开启/关闭持久化维护模式并写审计（DEPLOYMENT §8；仅宿主机入口，ADR-026）
  bootstrap-admin <用户名>        创建首个管理员（仅 users 表为空时允许；密码从标准输入读取，
                                  不进入命令历史，DEPLOYMENT §6 步骤 8）
EOF
}

require_env_file() {
    if [ ! -f "$ENV_FILE" ]; then
        log_fail "缺少部署配置：$ENV_FILE"
        echo "  请先执行：cp deployment/env/.env.example deployment/compose/.env  并填写（见 deployment/README.md）"
        exit 1
    fi
}

env_get() {
    # 取 .env 中 KEY 的最后一次赋值（值与注释无关，不处理引号转义）
    grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -n 1 | cut -d= -f2- || true
}

check_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        log_fail "未找到 docker 命令（需要 Docker Engine + Compose v2，DEPLOYMENT §1）"
        exit 1
    fi
    if ! docker compose version >/dev/null 2>&1; then
        log_fail "docker compose v2 不可用"
        exit 1
    fi
}

# postgres 容器内的 psql（以 postgres 系统用户走本机 socket peer 认证，不接触任何密码）
pg_exec() {
    compose exec -T -u postgres postgres psql -d warden -v ON_ERROR_STOP=1 -tA -q "$@"
}

require_postgres_up() {
    if ! compose ps --quiet postgres 2>/dev/null | grep -q .; then
        log_fail "postgres 服务未运行：请先 docker compose -f $COMPOSE_FILE up -d postgres"
        exit 1
    fi
}

preflight() {
    require_env_file
    ok=1

    # 1) docker / compose v2
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        log_info "docker compose v2 可用：$(docker compose version --short)"
        if docker compose -f "$COMPOSE_FILE" config --quiet; then
            log_info "compose 配置可解析（deployment/compose/compose.yaml）"
        else
            log_fail "compose 配置解析失败，请检查 deployment/compose/.env 与 compose.yaml"
            ok=0
        fi
    else
        log_fail "docker 或 docker compose v2 不可用（DEPLOYMENT §1）"
        ok=0
    fi

    # 2) 主机时间
    now=$(date -u +%s)
    if [ "$now" -lt 1735689600 ]; then
        log_fail "主机时间异常（早于 2025-01-01）：$(date -u -Iseconds)"
        ok=0
    else
        log_info "主机时间正常：$(date -u -Iseconds)"
    fi
    if command -v timedatectl >/dev/null 2>&1 && timedatectl 2>/dev/null | grep -q 'NTP service:.*inactive'; then
        log_warn "NTP 未激活，建议启用时间同步（DEPLOYMENT §1）"
    fi

    # 3) 持久化目录（DEPLOYMENT §4/§7）
    data_dir=$(env_get WARDEN_DATA_DIR)
    data_dir=${data_dir:-/srv/warden}
    for d in postgres files tls secrets; do
        p="$data_dir/$d"
        if [ ! -d "$p" ]; then
            log_fail "目录缺失：$p（需预创建；postgres 与 files 属主见 deployment/README.md）"
            ok=0
            continue
        fi
        case "$d" in
            postgres|files)
                [ -w "$p" ] || { log_fail "目录不可写：$p"; ok=0; }
                ;;
            tls|secrets)
                m=$(stat -c %a "$p" 2>/dev/null || echo ?)
                [ "$m" = "700" ] || [ "$m" = "750" ] || log_warn "$p 权限为 $m，建议 0700（tls 可 0750）"
                ;;
        esac
    done

    # 4) Secret 文件存在且非空（DEPLOYMENT §5；权限 0600 建议）
    for f in credential_master_key file_master_key session_secret csrf_secret \
             postgres_dsn postgres_dsn_migrate postgres_superuser_password; do
        p="$data_dir/secrets/$f"
        if [ ! -f "$p" ]; then
            log_fail "Secret 文件缺失：$p"
            ok=0
            continue
        fi
        [ -s "$p" ] || { log_fail "Secret 文件为空：$p"; ok=0; }
        m=$(stat -c %a "$p" 2>/dev/null || echo ?)
        case "$m" in
            600|400|200|100|000) ;;
            *) log_warn "$p 权限为 $m，建议 0600" ;;
        esac
    done

    # TLS 证书（tls 目录只读挂载给 Nginx）
    for f in fullchain.pem privkey.pem; do
        [ -f "$data_dir/tls/$f" ] || { log_fail "TLS 文件缺失：$data_dir/tls/$f"; ok=0; }
    done

    # 5) 设备管理网 CIDR（空则探测全部拒绝，DEPLOYMENT §3/§5）
    cidrs=$(env_get WARDEN_ALLOWED_DEVICE_CIDRS)
    if [ -n "$cidrs" ]; then
        log_info "WARDEN_ALLOWED_DEVICE_CIDRS 已设置：$cidrs"
    else
        log_fail "WARDEN_ALLOWED_DEVICE_CIDRS 为空：设备探测将全部拒绝（DEPLOYMENT §3/§5）"
        ok=0
    fi

    # 6) 生产环境拒绝明文 HTTP（DEPLOYMENT §5 启动检查）
    app_env=$(env_get WARDEN_APP_ENV)
    app_env=${app_env:-production}
    pub_url=$(env_get WARDEN_PUBLIC_URL)
    case "$pub_url" in
        https://*)
            log_info "WARDEN_PUBLIC_URL：$pub_url"
            ;;
        http://*)
            if [ "$app_env" = "production" ]; then
                log_fail "生产环境（WARDEN_APP_ENV=$app_env）的 WARDEN_PUBLIC_URL 不得使用 http://"
                ok=0
            else
                log_warn "WARDEN_PUBLIC_URL 使用明文 http，仅限开发环境"
            fi
            ;;
        "")
            log_fail "WARDEN_PUBLIC_URL 未设置"
            ok=0
            ;;
        *)
            log_fail "WARDEN_PUBLIC_URL 格式无效：$pub_url"
            ok=0
            ;;
    esac

    # 7) 镜像引用（无公网交付必须 digest 固定，DEPLOYMENT §10）
    for img in WARDEN_IMAGE_APP WARDEN_IMAGE_NGINX WARDEN_IMAGE_POSTGRES; do
        v=$(env_get "$img")
        if [ -z "$v" ]; then
            log_warn "$img 未设置，使用 compose 内默认值（本地验证场景）"
            continue
        fi
        case "$v" in
            *REPLACE*)
                log_fail "$img 仍为占位符：$v（请替换为 digest 固定引用，如 xxx@sha256:<64位hex>）"
                ok=0
                ;;
            *@sha256:*)
                d=${v##*@sha256:}
                case "$d" in
                    *[!0-9a-f]*) log_fail "$img digest 含非法字符：$d"; ok=0 ;;
                    *) [ "${#d}" -eq 64 ] || { log_fail "$img digest 长度不是 64：$d"; ok=0; } ;;
                esac
                ;;
        esac
    done

    if [ "$ok" -eq 1 ]; then
        echo
        echo "预检完成：全部通过。可以继续 DEPLOYMENT §6 步骤 5-8。"
    else
        echo
        echo "预检未通过：请修复以上 [失败] 项后重试。"
        exit 1
    fi
}

maintenance() {
    if [ $# -ne 1 ] || { [ "$1" != "on" ] && [ "$1" != "off" ]; }; then
        log_fail "用法：warden maintenance on|off"
        exit 2
    fi
    require_env_file
    check_docker
    require_postgres_up

    # system_state 表由迁移 0015_system_state 创建；缺失时给出明确错误（不允许绕过约束）
    has_table=$(pg_exec -c "SELECT to_regclass('public.system_state') IS NOT NULL" 2>/dev/null)
    if [ "$has_table" != "t" ]; then
        log_fail "system_state 表不存在：请先运行数据库迁移（docker compose run --rm migrate，0015_system_state 提供该表）"
        exit 1
    fi

    state_enabled=$([ "$1" = "on" ] && printf true || printf false)
    # 0015 单行表（CHECK id = 1）：开关与 since/reason 同在一行；on 记录窗口
    # 起点（maintenance_since），off 清空。列布局与应用层同语义
    # （backend/app/application/system_state.py：enter/exit_maintenance）。
    if [ "$1" = "on" ]; then
        since_expr="now()"
    else
        since_expr="NULL"
    fi
    pg_exec -c "INSERT INTO system_state (id, maintenance_mode, maintenance_since, maintenance_reason, updated_at)
                VALUES (1, $state_enabled, $since_expr, NULL, now())
                ON CONFLICT (id) DO UPDATE SET maintenance_mode = excluded.maintenance_mode,
                    maintenance_since = excluded.maintenance_since,
                    maintenance_reason = excluded.maintenance_reason,
                    updated_at = excluded.updated_at"

    # 审计（DEPLOYMENT §8）：列名与 0002/0004 迁移一致（actor_user_id/session_id/
    # requirement_id/detail_jsonb/occurred_at...）。宿主机 CLI 没有用户会话，
    # actor_user_id 保持 NULL，来源记在 detail（与 system_state.py 的
    # HOST_CLI_SOURCE/审计行同构）。audit_logs/ui_events 缺失时告警但不阻断状态变更。
    audit_detail="jsonb_build_object('source', 'deployment_cli', 'maintenance_enabled', false)"
    if [ "$1" = "on" ]; then
        audit_detail="jsonb_build_object('source', 'deployment_cli', 'maintenance_enabled', true, 'maintenance_since', maintenance_since::text)"
    fi
    has_audit=$(pg_exec -c "SELECT to_regclass('public.audit_logs') IS NOT NULL" 2>/dev/null)
    if [ "$has_audit" = "t" ]; then
        # id 无数据库默认值（应用层在客户端生成 uuid7）；CLI 用 gen_random_uuid()
        pg_exec -c "INSERT INTO audit_logs (id, actor_user_id, session_id, action, resource_type, resource_id, requirement_id, result, detail_jsonb)
                    SELECT gen_random_uuid(), NULL, NULL, 'maintenance.$1', 'system_state', 'maintenance_mode', 'PLT-08', 'success', $audit_detail
                    FROM system_state WHERE id = 1"
    else
        log_warn "audit_logs 表不存在，本次变更未写审计记录（迁移补齐后重新执行该命令补记）"
    fi

    # SSE 刷新信号（API_CONTRACT.md §10）：维护状态变化立即推给前端顶栏/system 页
    has_events=$(pg_exec -c "SELECT to_regclass('public.ui_events') IS NOT NULL" 2>/dev/null)
    if [ "$has_events" = "t" ]; then
        pg_exec -c "INSERT INTO ui_events (entity_type, entity_id, version, event_type, payload)
                    VALUES ('system', NULL, 1, 'system.status_changed', '{}'::jsonb)"
    else
        log_warn "ui_events 表不存在，本次变更未发 SSE 刷新事件（迁移补齐后重新执行该命令补发）"
    fi

    log_info "维护模式已$([ "$1" = "on" ] && printf 开启 || printf 关闭)：system_state.maintenance_mode = $state_enabled"
}

bootstrap_admin() {
    if [ $# -ne 1 ]; then
        log_fail "用法：warden bootstrap-admin <用户名>"
        exit 2
    fi
    username=$1
    case "$username" in
        ""|*[!A-Za-z0-9._-]*) log_fail "用户名只允许字母、数字和 . _ - 字符"; exit 2 ;;
    esac
    require_env_file
    check_docker
    require_postgres_up

    # 只在 users 表为空时允许（DEPLOYMENT §6 步骤 8）
    has_users=$(pg_exec -c "SELECT to_regclass('public.users') IS NOT NULL" 2>/dev/null)
    if [ "$has_users" != "t" ]; then
        log_fail "users 表不存在：请先运行一次性迁移（docker compose run --rm migrate，M2 提供 users 表）"
        exit 1
    fi
    cnt=$(pg_exec -c "SELECT count(*) FROM users" 2>/dev/null)
    if [ "$cnt" -gt 0 ] 2>/dev/null; then
        log_fail "users 表已有 $cnt 条用户记录：拒绝引导（DEPLOYMENT §6 步骤 8：仅首次且无用户时可执行）"
        exit 1
    fi

    echo "users 表为空，允许引导。请稍后在提示下输入密码（从标准输入读取，不进入命令历史）。"
    # 密码逻辑由后端 app.tools.bootstrap_admin 实现（M2 提供该模块；契约见 deployment/scripts/README.md）：
    # 从 stdin 或 WARDEN_BOOTSTRAP_PASSWORD_FILE 读取，绝不从 argv 读取；Argon2id 参数见 SECURITY §2。
    compose run --rm --no-deps \
        -e "WARDEN_BOOTSTRAP_ADMIN_USERNAME=$username" \
        --entrypoint python \
        api -m app.tools.bootstrap_admin
}

cmd=${1:-}
[ $# -gt 0 ] && shift || true
case "$cmd" in
    preflight) preflight ;;
    maintenance) maintenance "$@" ;;
    bootstrap-admin) bootstrap_admin "$@" ;;
    help|-h|--help|"") usage ;;
    *) log_fail "未知命令：$cmd"; usage; exit 2 ;;
esac
